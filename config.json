{
    "app": {
        "name": "Système de reconnaissance faciale - CITEX SART",
        "version": "1.0.0",
        "created_at": "2025-04-29 12:00:07"
    },
    "database": {
        "path": "data/employees.db"
    },
    "face_recognition": {
        "min_confidence": 50,
        "max_images": 300,
